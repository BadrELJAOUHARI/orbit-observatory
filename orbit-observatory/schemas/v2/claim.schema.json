{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "id",
    "document_id",
    "event_id",
    "lens_id",
    "target_text",
    "start",
    "end",
    "quote",
    "text_sha256",
    "offset_unit",
    "speaker",
    "attribution_status",
    "status",
    "selection_method",
    "qualifications",
    "unresolved_reason",
    "reading_text",
    "source_indices",
    "segment_kind",
    "derived_from",
    "quality_issues",
    "paragraph_id",
    "segmentation_version"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_type": {
      "const": "claim"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "lens_id": {
      "enum": [
        "territorial_recognition",
        "troop_withdrawal",
        "military_assistance",
        "sanctions",
        "invasion_responsibility"
      ]
    },
    "target_text": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "offset_unit": {
      "const": "unicode_code_point_half_open"
    },
    "speaker": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution_status": {
      "enum": [
        "pending",
        "attributable",
        "unresolved"
      ]
    },
    "status": {
      "const": "annotation_candidate"
    },
    "selection_method": {
      "const": "source_aligned_sentences_v2"
    },
    "qualifications": {
      "type": [
        "string",
        "null"
      ]
    },
    "unresolved_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reading_text": {
      "type": "string",
      "minLength": 1
    },
    "source_indices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "segment_kind": {
      "enum": [
        "sentence",
        "html_paragraph",
        "retained_review_window"
      ]
    },
    "derived_from": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "quality_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "extraction_boundary",
          "extraction_header_in_envelope",
          "extraction_hyphenation",
          "attribution_actor_mismatch",
          "attribution_unknown",
          "scope_insufficiency",
          "scope_hold_W1",
          "language_review",
          "translation_review",
          "EU_common_position_review"
        ]
      }
    },
    "paragraph_id": {
      "type": "string"
    },
    "segmentation_version": {
      "const": "orbit-segmentation-2.0.0"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit:claim-span-revision:v1.1"
}
