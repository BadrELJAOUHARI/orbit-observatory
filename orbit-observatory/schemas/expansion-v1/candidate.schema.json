{
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "id",
    "document_id",
    "event_id",
    "actor_id",
    "lens_id",
    "text_sha256",
    "start",
    "end",
    "exact_passage",
    "reading_text",
    "source_indices",
    "quality_issues",
    "origin",
    "scoring_eligible",
    "training_approved"
  ],
  "properties": {
    "record_type": {
      "const": "expansion_candidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "lens_id": {
      "type": "string",
      "minLength": 1
    },
    "exact_passage": {
      "type": "string",
      "minLength": 1
    },
    "reading_text": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "enum": [
        "EU",
        "IND",
        "RUS",
        "TUR",
        "UKR",
        "USA",
        "ZAF"
      ]
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 1
    },
    "source_indices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "quality_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "const": "retrieval_not_prediction"
    },
    "scoring_eligible": {
      "const": false
    },
    "training_approved": {
      "const": false
    }
  }
}
