{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit:records:v1",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/claim"
    },
    {
      "$ref": "#/$defs/annotation"
    },
    {
      "$ref": "#/$defs/prediction"
    }
  ],
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "actor_id",
        "event_id",
        "title",
        "issuer",
        "publisher",
        "canonical_url",
        "manifest_url",
        "resolved_url",
        "delivery_date",
        "publication_date",
        "date_basis",
        "retrieved_at",
        "language",
        "source_scope_version",
        "stream",
        "raw_sha256",
        "text_sha256",
        "normalization_version",
        "raw_path",
        "text_path",
        "duplicate_of",
        "translation_of",
        "translation_provenance",
        "rights_status"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "record_type": {
          "const": "document"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "enum": [
            "USA",
            "EU",
            "TUR",
            "IND",
            "ZAF"
          ]
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "manifest_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "resolved_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "delivery_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_basis": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
        },
        "source_scope_version": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "enum": [
            "official_statement",
            "un_general_debate"
          ]
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "normalization_version": {
          "const": "orbit-text-v1"
        },
        "raw_path": {
          "type": "string",
          "minLength": 1
        },
        "text_path": {
          "type": "string",
          "minLength": 1
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "translation_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "translation_provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_status": {
          "const": "local_research_only_not_cleared_for_redistribution"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "actor_ids",
        "event_date",
        "event_type",
        "source_scope_version",
        "stream",
        "document_ids",
        "duplicate_cluster_id",
        "joint_statement_id",
        "clustering_method"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "record_type": {
          "const": "event"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "enum": [
              "USA",
              "EU",
              "TUR",
              "IND",
              "ZAF"
            ]
          },
          "uniqueItems": true
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "source_scope_version": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "enum": [
            "official_statement",
            "un_general_debate"
          ]
        },
        "document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "duplicate_cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "joint_statement_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "clustering_method": {
          "enum": [
            "manifest_review_required",
            "reviewed_manifest"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "document_id",
        "event_id",
        "lens_id",
        "target_text",
        "start",
        "end",
        "quote",
        "text_sha256",
        "offset_unit",
        "speaker",
        "attribution_status",
        "status",
        "selection_method",
        "qualifications",
        "unresolved_reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "record_type": {
          "const": "claim"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "lens_id": {
          "enum": [
            "territorial_recognition",
            "troop_withdrawal",
            "military_assistance",
            "sanctions",
            "invasion_responsibility"
          ]
        },
        "target_text": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "offset_unit": {
          "const": "unicode_code_point_half_open"
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution_status": {
          "enum": [
            "pending",
            "attributable",
            "unresolved"
          ]
        },
        "status": {
          "const": "annotation_candidate"
        },
        "selection_method": {
          "const": "keyword_paragraph_v1"
        },
        "qualifications": {
          "type": [
            "string",
            "null"
          ]
        },
        "unresolved_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "claim_id",
        "origin",
        "annotator_id",
        "codebook_version",
        "label",
        "review_status",
        "created_at",
        "rationale",
        "supersedes"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "record_type": {
          "const": "annotation"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "editorial",
            "human"
          ]
        },
        "annotator_id": {
          "type": "string",
          "minLength": 1
        },
        "codebook_version": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "enum": [
            "support",
            "oppose",
            "no_stance",
            "unresolved",
            "not_applicable"
          ]
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "independent",
            "adjudicated"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "claim_id",
        "origin",
        "model_version",
        "training_data_version",
        "calibration_version",
        "calibrated",
        "created_at",
        "eligibility",
        "support_probability",
        "stance_score"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "record_type": {
          "const": "prediction"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "const": "model"
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "training_data_version": {
          "type": "string",
          "minLength": 1
        },
        "calibration_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibrated": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "eligibility": {
          "enum": [
            "stance_bearing",
            "no_stance",
            "unresolved"
          ]
        },
        "support_probability": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stance_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligibility": {
                "const": "stance_bearing"
              }
            }
          },
          "then": {
            "properties": {
              "support_probability": {
                "type": "number"
              },
              "stance_score": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "support_probability": {
                "type": "null"
              },
              "stance_score": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "calibrated": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "calibration_version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "calibration_version": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
