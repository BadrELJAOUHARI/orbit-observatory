{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "id",
    "document_id",
    "event_id",
    "lens_id",
    "target_text",
    "start",
    "end",
    "quote",
    "text_sha256",
    "offset_unit",
    "speaker",
    "attribution_status",
    "status",
    "selection_method",
    "qualifications",
    "unresolved_reason",
    "revision_of",
    "revision_reason",
    "revision_requested_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "record_type": {
      "const": "claim"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "lens_id": {
      "enum": [
        "territorial_recognition",
        "troop_withdrawal",
        "military_assistance",
        "sanctions",
        "invasion_responsibility"
      ]
    },
    "target_text": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "offset_unit": {
      "const": "unicode_code_point_half_open"
    },
    "speaker": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution_status": {
      "enum": [
        "pending",
        "attributable",
        "unresolved"
      ]
    },
    "status": {
      "const": "annotation_candidate"
    },
    "selection_method": {
      "const": "review_requested_span_expansion_v1"
    },
    "qualifications": {
      "type": [
        "string",
        "null"
      ]
    },
    "unresolved_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision_of": {
      "type": "string",
      "minLength": 1
    },
    "revision_reason": {
      "type": "string",
      "minLength": 1
    },
    "revision_requested_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit:claim-span-revision:v1.1"
}
